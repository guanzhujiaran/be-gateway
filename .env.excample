DB=postgres://postgres:114514@127.0.0.1:10004/PPTR_Bili_Lot
REDIS_HOST=127.0.0.1
REDIS_PORT=10001
REDIS_DB=2
REDIS_PWD=
BILI_CRAWLER_URI=http://192.168.81.172:10005
RPA_SERVICE_URI=http://127.0.0.1:10012
MESSAGE_SERVICE_URI=http://message-service:18739

# 前端URL配置
FRONTEND_URL=http://localhost:5173

# Casdoor配置
CASDOOR_ENABLED=true
# casdoor的后端，如果是docker的话需要在同一个网络下，通过服务名:8000访问，如：http://fastapi-casdoor:8000
CASDOOR_ENDPOINT=http://localhost:10011
CASDOOR_CLIENT_ID=your-client-id
CASDOOR_CLIENT_SECRET=your-client-secret
CASDOOR_ORGANIZATION=your-organization
CASDOOR_APPLICATION=your-application
CASDOOR_CERTIFICATE=your-certificate

# ==================== 网关错误告警（ErrorReporter） ====================
# 全部为可选项，不配置时使用括号内默认值；改完需重启网关生效。
# 上游响应触发告警的最低 HTTP 状态码（500=仅 5xx；改 400 可同时观察 405/401 等 4xx）
GATEWAY_ALERT_UPSTREAM_MIN_STATUS=500
# 聚合窗口，毫秒（10000）
GATEWAY_ALERT_FLUSH_INTERVAL_MS=10000
# 同类错误推送后的冷却期，毫秒（60000），0 表示每次都推
GATEWAY_ALERT_SERIES_COOLDOWN_MS=60000
# 单次推送最多展示的错误类型数（20）
GATEWAY_ALERT_DETAIL_LIMIT=20
# 聚合桶数量上限（500）
GATEWAY_ALERT_MAX_BUCKETS=500
# 直连兜底推送超时，毫秒（5000）
GATEWAY_ALERT_PUSH_TIMEOUT_MS=5000
# 走 be-message RPC 推送超时，毫秒（30000）
GATEWAY_ALERT_RPC_PUSH_TIMEOUT_MS=30000
